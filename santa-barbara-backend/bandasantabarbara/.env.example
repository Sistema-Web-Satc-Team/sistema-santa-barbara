
# ==============================
# SISTEMA SANTA BÁRBARA
# Exemplo de configuração
# ==============================

# Perfil Spring
SPRING_PROFILES_ACTIVE=dev

# Banco de dados
DATABASE_URL=jdbc:postgresql://localhost:5433/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# JWT
JWT_PUBLIC_PEM_KEY_PATH=classpath:certs/public.pem
JWT_PRIVATE_PEM_KEY_PATH=classpath:certs/private.pem
JWT_EXPIRATION_SECONDS=7200

# Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_INVITATION_URL=http://localhost:3000/convidar-membro/

# SMTP
MAIL_HOST=localhost
MAIL_PORT=3025
MAIL_USERNAME=
MAIL_PASSWORD=

# Storage
STORAGE_LOCAL_ROOT=./storage

# Banco de testes
TEST_DATABASE_URL=jdbc:postgresql://localhost:5434/postgres_test
TEST_DATABASE_USERNAME=test
TEST_DATABASE_PASSWORD=test

# Origens autorizadas a acessar a API pelo navegador
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000